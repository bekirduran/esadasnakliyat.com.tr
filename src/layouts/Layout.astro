---
import { site } from '../data/site';
import '../styles.css';
interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  schema?: Record<string, unknown>;
  preloadHero?: boolean;
}
const { title, description, noindex = false, schema, preloadHero = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const business = {
  '@type': 'MovingCompany',
  '@id': site.url + '/#business',
  name: site.name,
  url: site.url,
  logo: site.url + '/esadas-icon.png',
  image: site.url + '/esadas-icon.png',
  hasMap: site.mapsUrl,
  areaServed: { '@type': 'City', name: 'Ankara' },
  telephone: [site.tel, site.secondaryTel, site.landlineTel],
  email: site.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.streetAddress,
    addressLocality: 'Çankaya',
    addressRegion: 'Ankara',
    postalCode: '06450',
    addressCountry: { '@type': 'Country', name: 'TR' },
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 39.880547,
    longitude: 32.839685,
  },
};
const website = {
  '@type': 'WebSite',
  '@id': site.url + '/#website',
  url: site.url,
  name: site.name,
  inLanguage: 'tr-TR',
  publisher: { '@id': site.url + '/#business' },
};
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#102c3c" />
    <title>{title} | Esadaş Nakliyat</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow'} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/json" href="/hizmetler.json" title="Hizmet kataloğu" />
    <link rel="alternate" type="text/markdown" href="/llms.txt" title="LLM site özeti" />
    {preloadHero && <link rel="preload" as="image" href="/media/hero" fetchpriority="high" />}
    <link rel="icon" href="/esadas-icon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/esadas-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image:alt" content="Esadaş Nakliyat resmî logosu" />
    <meta property="og:image" content={site.url + '/esadas-icon.png'} />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@graph': schema ? [business, website, schema] : [business, website],
      }).replaceAll('<', '\\u003c')}
    ></script>
  </head>
  <body>
    <a class="skip" href="#main">
      İçeriğe geç
    </a>
    <div class="topbar">
      <span>Ankara’dan yeni başlangıçlara.</span>
      <a href={`tel:${site.tel}`}>Bizi arayın: {site.phone}</a>
    </div>
    <header>
      <a class="brand" href="/" aria-label="Esadaş Nakliyat ana sayfa">
        <img
          class="official-brand-icon"
          src="/esadas-header-icon.webp"
          alt=""
          width="48"
          height="48"
        />
        <span>
          ESADAŞ<small>NAKLİYAT & DEPOLAMA</small>
        </span>
      </a>
      <nav aria-label="Ana menü">
        <a href="/hizmetler/">Hizmetler</a>
        <a href="/esya-depolama/">Depolama</a>
        <a href="/hizmetler/bolgeler/">Bölgeler</a>
        <a href="/hakkimizda/">Hakkımızda</a>
        <a href="/iletisim/">İletişim</a>
      </nav>
      <a class="button small" href="/teklif/">
        Teklif alın <span>↗</span>
      </a>
    </header>
    <main id="main">
      <slot />
    </main>
    <section class="closing">
      <div>
        <span class="eyebrow">YENİ BİR BAŞLANGIÇ İÇİN</span>
        <h2>
          Siz yeni hayatınızı planlayın.
          <br />
          Taşınmayı birlikte çözelim.
        </h2>
      </div>
      <a class="button cream" href="/teklif/">
        Taşınma planı oluşturun ↗
      </a>
    </section>
    <footer>
      <div>
        <a class="brand" href="/">
          ESADAŞ<small>NAKLİYAT & DEPOLAMA</small>
        </a>
        <p>
          Taşınırken de, beklerken de
          <br />
          eşyalarınız için düşünülmüş çözümler.
        </p>
      </div>
      <div>
        <h3>Keşfedin</h3>
        <a href="/hizmetler/">Hizmetlerimiz</a>
        <a href="/hizmetler/bolgeler/">Hizmet bölgeleri</a>
        <a href="/hizmetler/bolgeler/ankara/">Ankara nakliyat</a>
        <a href="/rehber/">Taşınma rehberi</a>
        <a href={site.storageUrl} rel="noopener">
          Esadaş Ankara Eşya Depolama ↗
        </a>
      </div>
      <div>
        <h3>Birlikte planlayalım</h3>
        <a href={`tel:${site.tel}`}>{site.phone}</a>
        <a href={`tel:${site.secondaryTel}`}>İkincil hat: {site.secondaryPhone}</a>
        <a href={`tel:${site.landlineTel}`}>Sabit hat: {site.landlinePhone}</a>
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <p>{site.address}</p>
      </div>
      <div class="footer-bottom">
        <span class="footer-attribution">
          © {new Date().getFullYear()} Esadaş Nakliyat
          <a href="https://btmasasi.com/" target="_blank" rel="noopener noreferrer">
            Tasarım: BT Masasi
          </a>
        </span>
        <a href="/gizlilik/">Gizlilik ve kişisel veriler</a>
        <a href="/admin/">Yönetim</a>
      </div>
    </footer>
    <a
      class="contact-float"
      href={`https://wa.me/${site.whatsapp}`}
      aria-label="WhatsApp ile Esadaş'a ulaşın"
    >
      WhatsApp ↗
    </a>
  </body>
</html>
