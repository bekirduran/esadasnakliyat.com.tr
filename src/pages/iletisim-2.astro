---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
---

<Layout
  title="İletişim — Ankara"
  description="Esadaş Nakliyat Ankara iletişim: telefon, WhatsApp, e-posta ve teklif formu. Taşınma ve depolama planınızı birlikte oluşturalım."
>
  <section class="section">
    <span class="eyebrow">BİZE ULAŞIN</span>
    <h1>
      Bir merhaba,
      <br />
      iyi bir başlangıç.
    </h1>
    <div class="service-grid">
      <article class="admin-card">
        <h2>Arayın</h2>
        <a href={`tel:${site.tel}`}>{site.phone}</a>
        <p>
          Alternatif hat: <a href="tel:+903124819839">0312 481 98 39</a>
        </p>
        <a class="button" href={`https://wa.me/${site.whatsapp}`}>
          WhatsApp ↗
        </a>
      </article>
      <article class="admin-card">
        <h2>Yazın</h2>
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <p>Adres, tarih ve eşya bilgilerinizi teklif formuyla iletebilirsiniz.</p>
        <a class="button outline" href="/teklif/">
          Teklif formu ↗
        </a>
      </article>
      <article class="admin-card">
        <h2>Ankara</h2>
        <p>{site.address}</p>
        <p>Ziyaret öncesinde telefonla iletişime geçin.</p>
        <a
          class="button outline"
          href="https://www.google.com/maps/dir//Esada%C5%9F+Evden+Eve+Nakliyat,+%C4%B0lk+ad%C4%B1m+mahallesi+atayolu+sokak,+Dikmen+Cd+34%2Fb,+06450+%C3%87ankaya%2FAnkara/@39.7979626,32.883107,11z/data=!4m8!4m7!1m0!1m5!1m1!1s0x14d3457848b1aaf7:0x887ae35f2d34f032!2m2!1d32.839685!2d39.880547?hl=tr-TR&entry=ttu&g_ep=EgoyMDI2MDkwOS4wIKXMDSoASAFQAw%3D%3D"
          target="_blank"
          rel="noopener noreferrer"
        >
          Google Maps’te yol tarifi al ↗
        </a>
      </article>
    </div>
  </section>
</Layout>
