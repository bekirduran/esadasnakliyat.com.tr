---
import Layout from '../layouts/Layout.astro';
import Media from '../components/Media.astro';
import { services, site } from '../data/site';
---

<Layout
  title="Ankara Evden Eve Nakliyat ve Eşya Depolama"
  description="Ankara evden eve nakliyat, asansörlü taşımacılık ve eşya depolama. Taşınma ihtiyaçlarınızı paylaşın, size uygun hizmet kapsamını birlikte planlayalım."
>
  <section class="hero">
    <div class="hero-copy">
      <span class="eyebrow">
        <i></i> ANKARA MERKEZLİ TAŞIMA & DEPOLAMA
      </span>
      <h1>
        Yeni evinize
        <br />
        giden yol,
        <br />
        <em>iyi bir planla</em>
        <br />
        başlar.
      </h1>
      <p>
        Bir ev dolusu hatıra, yeni bir başlangıç.
        <br />
        Paketlemeden yerleşmeye, taşınmanın her adımını birlikte planlıyoruz.
      </p>
      <div class="actions">
        <a class="button" href="/teklif/">
          Taşınmamı planla ↗
        </a>
        <a class="text-link" href="/hizmetler/">
          Hizmetleri keşfet ↓
        </a>
      </div>
      <div class="hero-note">
        <span>01 /</span> Evden eve nakliyat · Asansörlü taşıma · Depolama
      </div>
    </div>
    <div class="hero-visual">
      <Media slot="hero" alt="Taşınma hazırlığını gösteren temsili illüstrasyon" eager />
      <div class="visual-tag">
        <span class="tag-icon">↗</span>
        <div>
          Her eşyanın bir hikâyesi var.<small>Yeni adresinizde devam etsin.</small>
        </div>
      </div>
      <span class="image-caption">Temsili görsel</span>
    </div>
  </section>
  <div class="benefits">
    <div>
      <span>01</span> İhtiyaca göre planlama
    </div>
    <div>
      <span>02</span> Özenli paketleme
    </div>
    <div>
      <span>03</span> Kapsamı net teklif
    </div>
    <div>
      <span>04</span> Tek noktadan iletişim
    </div>
  </div>
  <section class="section">
    <div class="section-heading">
      <div>
        <span class="eyebrow">HAYAT DEĞİŞİR. İHTİYAÇLAR DA.</span>
        <h2>
          Her başlangıca
          <br />
          uygun bir çözüm.
        </h2>
      </div>
      <p>
        İster başka bir mahalleye, ister başka bir şehre.
        <br />
        İhtiyacınıza uygun hizmeti birlikte belirleyelim.
      </p>
    </div>
    <div class="service-grid">
      {services.slice(0, 3).map((s, i) => (
        <a class="service-card" href={`/${s.slug}/`}>
          <div class="card-image">
            <Media slot={s.image} alt={`${s.name} için temsili illüstrasyon`} />
            <span class="round-arrow">↗</span>
          </div>
          <div class="card-copy">
            <small>
              0{i + 1} / {s.label}
            </small>
            <h3>{s.name}</h3>
            <p>{s.summary}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
  <section class="storage-feature">
    <div class="storage-image">
      <Media slot="storage" alt="Depolama hizmeti için temsili oda ve kutu illüstrasyonu" />
    </div>
    <div class="storage-copy">
      <span class="eyebrow">BAZEN SADECE BİRAZ ALAN GEREKİR.</span>
      <h2>
        Evinizde yer açın.
        <br />
        <em>Hayatınıza da.</em>
      </h2>
      <p>
        Yeni eviniz hazır değil mi? Tadilat mı var? Eşyalarınız için depolama, paketleme ve taşıma
        ihtiyaçlarını tek bir plan içinde değerlendirelim.
      </p>
      <ul class="check-list">
        <li>Eşya miktarınıza göre oda seçenekleri</li>
        <li>Süre ve erişim koşullarını önceden planlama</li>
        <li>Paketleme ve taşıma koordinasyonu</li>
      </ul>
      <a class="button" href="/esya-depolama-2/">
        Depolamayı keşfedin ↗
      </a>
      <a class="storage-external" href={site.storageUrl}>
        Depolamaya özel web sitemiz ↗
      </a>
    </div>
  </section>
  <section class="section">
    <div class="section-heading">
      <div>
        <span class="eyebrow">İYİ BİR TAŞINMA TESADÜF DEĞİLDİR.</span>
        <h2>
          Baştan sona,
          <br />
          adım adım yanınızda.
        </h2>
      </div>
      <a class="text-link" href="/rehber/">
        Taşınma rehberine göz atın ↗
      </a>
    </div>
    <div class="steps">
      {[
        ['Tanışalım', 'Adres, tarih ve eşya bilgilerinizi paylaşın.'],
        ['Planlayalım', 'Bina koşulları, ihtiyaçlar ve teklif kapsamını netleştirelim.'],
        ['Hazırlayalım', 'Paketleme, söküm ve taşıma işlemlerini planlayalım.'],
        ['Yerleşelim', 'Teslim ve montaj detaylarını birlikte kontrol edelim.'],
      ].map(([t, d], i) => (
        <div>
          <span>0{i + 1}</span>
          <h3>{t}</h3>
          <p>{d}</p>
        </div>
      ))}
    </div>
  </section>
  <section class="region-band">
    <div>
      <span class="eyebrow">ANKARA’DAN TÜRKİYE’YE</span>
      <h2>Rotanız neresi?</h2>
      <p>İl ve ilçe seçin, güzergâhınız için taşıma planını konuşalım.</p>
    </div>
    <a class="button outline" href="/hizmetler/bolgeler/">
      Bölgeleri inceleyin ↗
    </a>
  </section>
</Layout>
