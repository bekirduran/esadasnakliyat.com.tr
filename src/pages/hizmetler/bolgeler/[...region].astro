---
import Layout from '../../../layouts/Layout.astro';
import { provinces, regionPath, serviceRegionPath } from '../../../data/geo';
import { services, site } from '../../../data/site';
export function getStaticPaths() {
  return provinces.flatMap((city) => [
    { params: { region: city.slug }, props: { city, district: undefined } },
    ...city.districts.map((district) => ({
      params: { region: city.slug + '/' + district.slug },
      props: { city, district },
    })),
  ]);
}
const { city, district } = Astro.props;
const label = district ? `${city.name} ${district.name}` : city.name;
const title = `${label} Nakliyat ve Taşınma Planlama`;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Hizmet bölgeleri',
      item: site.url + '/hizmetler/bolgeler/',
    },
    { '@type': 'ListItem', position: 2, name: city.name, item: site.url + regionPath(city.slug) },
    ...(district
      ? [
          {
            '@type': 'ListItem',
            position: 3,
            name: district.name,
            item: site.url + regionPath(city.slug, district.slug),
          },
        ]
      : []),
  ],
};
---

<Layout
  title={title}
  description={`${label} için Ankara bağlantılı taşınma talebi oluşturun. Eşya miktarı, tarih ve bina koşullarına göre hizmet uygunluğunu öğrenin.`}
  noindex
  schema={schema}
>
  <section class="section">
    <div class="breadcrumb">
      <a href="/hizmetler/bolgeler/">Bölgeler</a> / <a href={regionPath(city.slug)}>{city.name}</a>
      {district && ` / ${district.name}`}
    </div>
    <h1>
      {label}
      <br />
      <em>taşınma planınız.</em>
    </h1>
    <section id="local-content">
      <p class="intro">
        {label} çıkışlı veya varışlı, Ankara bağlantılı bir taşınma mı planlıyorsunuz? Eşya
        miktarınızı, tarihinizi ve bina koşullarını paylaşarak güzergâhınıza uygun hizmeti
        öğrenebilirsiniz.
      </p>
      <p>
        Bu bölge için ayrıntılı hizmet bilgisi henüz yayınlanmamıştır. Yerel şube veya depo beyanı
        değildir; operasyon uygunluğu teklif sırasında doğrulanır.
      </p>
    </section>
    <a class="button" href={`/teklif/?bolge=${encodeURIComponent(label)}`}>
      Bu bölge için talep oluşturun ↗
    </a>
    <h2>Taşınma ihtiyacınıza göre keşfedin</h2>
    <div class="topic-links">
      {services.map((s) => (
        <a href={serviceRegionPath(s.slug, city.slug, district?.slug)}>{s.name} ↗</a>
      ))}
    </div>
    {!district && (
      <>
        <h2>{city.name} ilçeleri</h2>
        <div class="region-grid">
          {city.districts.map((d) => (
            <a href={regionPath(city.slug, d.slug)}>
              <strong>{d.name}</strong>
              <span>Taşınmayı planla ↗</span>
            </a>
          ))}
        </div>
      </>
    )}
    {district && (
      <>
        <h2>{city.name} içinde diğer bölgeler</h2>
        <div class="topic-links">
          {city.districts
            .filter((d) => d.id !== district.id)
            .slice(0, 8)
            .map((d) => (
              <a href={regionPath(city.slug, d.slug)}>{d.name}</a>
            ))}
        </div>
      </>
    )}
  </section>
</Layout>
