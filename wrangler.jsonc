{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "esadas-nakliyat",
  "account_id": "7b3ba6e92f9637e04a00500d703f1b91",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-12",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page",
  },
  "observability": { "enabled": true },
  "vars": { "ENVIRONMENT": "local", "SITE_URL": "https://esadasnakliyat.com.tr" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "esadas-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "esadas-local-media" }],
  "env": {
    "staging": {
      "name": "esadas-staging",
      "workers_dev": true,
      "vars": { "ENVIRONMENT": "staging", "SITE_URL": "https://esadasnakliyat.com.tr" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "esadas-staging",
          "database_id": "fc4146d3-0c84-4af9-b12b-260c13c09dd8",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "esadas-staging-media" }],
      "triggers": { "crons": ["17 3 * * *"] },
    },
    "production": {
      "name": "esadas-production",
      "routes": [
        { "pattern": "esadasnakliyat.com.tr/*", "zone_id": "7bfccf3aea915c8c57d8c907575fecfa" },
        { "pattern": "www.esadasnakliyat.com.tr/*", "zone_id": "7bfccf3aea915c8c57d8c907575fecfa" },
      ],
      "workers_dev": true,
      "vars": { "ENVIRONMENT": "production", "SITE_URL": "https://esadasnakliyat.com.tr" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "esadas-production",
          "database_id": "780f0713-2a53-45e9-a560-517f723ed4f8",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "esadas-production-media" }],
      "triggers": { "crons": ["37 3 * * *"] },
    },
  },
}
