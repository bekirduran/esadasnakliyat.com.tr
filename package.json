{
  "name": "esadas-nakliyat",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run build && wrangler dev --env staging",
    "build": "astro build",
    "types": "wrangler types",
    "check": "astro check && tsc --noEmit -p tsconfig.worker.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "preview": "wrangler dev --env staging",
    "db:local": "wrangler d1 migrations apply DB --local --env staging",
    "geo:sync": "node scripts/sync-geography.mjs",
    "deploy:staging": "npm run build && wrangler deploy --env staging",
    "deploy:production": "npm run build && wrangler deploy --env production"
  },
  "dependencies": {
    "astro": "^7.3.2",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^22.20.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "wrangler": "^4.131.1"
  }
}
